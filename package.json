{
  "name": "flow-voice-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --sort --workspace-concurrency=1 build",
    "typecheck": "pnpm -r --sort --workspace-concurrency=1 typecheck",
    "lint": "pnpm -r --sort --workspace-concurrency=1 lint",
    "test": "node --test scripts/release.test.mjs && pnpm -r --sort --workspace-concurrency=1 test"
  }
}
