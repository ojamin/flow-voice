{
  "name": "@flow-voice/server",
  "version": "0.7.2",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "flow-voice:source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "flow-voice:source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc-rs -p tsconfig.build.json",
    "typecheck": "tsc-rs --noEmit -p tsconfig.json",
    "lint": "oxlint src",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@flow-voice/core": "workspace:*",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "tsc-rs": "0.2.0",
    "oxlint": "^1.76.0",
    "vitest": "^4.1.10",
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1"
  }
}
